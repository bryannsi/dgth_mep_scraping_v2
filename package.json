{
  "name": "dgth_mep_scraping_v2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "pnpm run build",
    "start": "node ./build/index.js",
    "dev": "pnpm prisma generate && node --watch --watch-path=src ./src/index.js",
    "dev2": "node ./src/index.js",
    "generate": "pnpm prisma generate",
    "build": "pnpm prisma generate && node -e \"import('fs').then(fs => fs.rmSync('build', { recursive: true, force: true }))\" && node build.js",
    "test": "node --test tests/dateParsing.test.js",
	"postinstall": "puppeteer browsers install chrome"
    "scrape-nombramiento": "node src/run_nombramientos.js"
  },
  "keywords": [],
  "author": "Bryan Chavarría Hughes",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "googleapis": "^171.0.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "puppeteer": "^24.35.0",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "esbuild-node-externals": "^1.20.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  }
}
