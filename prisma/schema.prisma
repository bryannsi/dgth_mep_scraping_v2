generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vacancy {
  id               Int      @id @default(autoincrement())
  mepId            String   @map("mep_id") @db.Text
  vacante          String   @db.Text
  regional         String   @db.Text
  clasePuesto      String   @map("clase_puesto") @db.Text
  especialidad     String   @db.Text
  institucion      String   @db.Text
  lecciones        Int      @db.SmallInt
  rige             DateTime @db.Date
  vence            DateTime? @db.Date
  bitacoraCreacion DateTime @default(now()) @map("bitacora_creacion") @db.Timestamptz

  notificationLogs NotificationLog[]

  @@unique([mepId, regional, clasePuesto, rige, lecciones])
  @@index([bitacoraCreacion], name: "idx_vacantes_bitacora_creacion")
  @@index([rige], name: "idx_vacantes_rige")
  @@map("vacantes")
}

model NotificationLog {
  id                Int      @id @default(autoincrement())
  mepId             String?  @map("mep_id") @db.Text // Legacy field for views
  vacanteId         Int      @map("vacante_id")
  template          String   @db.Text
  fechaNotificacion DateTime @default(now()) @map("fecha_notificacion") @db.Timestamptz

  vacancy           Vacancy  @relation(fields: [vacanteId], references: [id], onDelete: Cascade, map: "log_notificaciones_vacante_fkey")

  @@unique([vacanteId, template])
  @@map("log_notificaciones")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String   // "error", "warn", "info"
  message   String   @db.Text
  details   String?  @db.Text
  timestamp DateTime @default(now()) @map("timestamp") @db.Timestamptz

  @@map("log_sistema")
}
model Client {
  id               Int      @id @default(autoincrement())
  templateKey      String   @unique @map("template_key") // "template1"
  name             String?  @map("nombre") @db.Text
  email            String   @map("email") @db.Text

  isActive         Boolean  @default(true) @map("esta_activo")
  isTest           Boolean  @default(false) @map("es_prueba")
  paymentVerified  Boolean  @default(true) @map("pago_verificado")
  expirationDate   DateTime @map("fecha_vencimiento") @db.Date

  // Campo JSON para flexibilidad total (keywords, cc, subject, etc.)
  config           Json     @default("{}") @map("configuracion")

  payments         Payment[]
  createdAt        DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz
  updatedAt        DateTime? @updatedAt @map("fecha_actualizacion") @db.Timestamptz

  @@map("clientes")
}

model Payment {
  id               Int      @id @default(autoincrement())
  clientId         Int      @map("cliente_id")
  amount           Decimal  @map("monto") @db.Decimal(10, 2)
  paymentDate      DateTime @default(now()) @map("fecha_pago") @db.Timestamptz
  reference        String?  @map("referencia") @db.Text
  
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("pagos")
}
